# scroldev.com on Apache hosting (Hostinger, Namecheap, cPanel and most shared hosts). Other hosts ignore this file.
# HTTPS: turn on "Force HTTPS" in the hosting panel once the free SSL certificate is active.

ErrorDocument 404 /404.html

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Compress text files on the way out.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/plain application/xml
</IfModule>

# Fonts, styles and scripts can be cached for a year: the page asks for styles.css?v=… and main.js?v=…, and that
# version changes with every build. Pages are always checked again.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
